# Copy to config/.env.development (or config/.env.production) and fill in real values.

# server
PORT=7000

# database
DB_URI=mongodb://127.0.0.1:27017/saraha

# bcrypt cost factor
SALT=10

# AES-256 field encryption (key must be exactly 32 characters, IV length 16)
ENCRYPTION_KEY=change-me-to-a-32-character-key!
IVLENGTH=16

# access token (lifetime in seconds)
ACCESS_TOKEN_SIGNATURE=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=3600

# refresh token (lifetime in seconds)
REFRESH_TOKEN_SIGNATURE=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=36000000

# Google sign-in
WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Redis
REDIS_URI=redis://127.0.0.1:6379

# SMTP (Gmail App Password) for OTP emails
APP_EMAIL=you@gmail.com
APP_PASSWORD=your-app-password

# display name used in emails
PROJECT_NAME=Saraha

# comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000
